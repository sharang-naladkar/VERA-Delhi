# ==============================================================================
# VERA Environment Configuration
# ==============================================================================

# Application
APP_ENV=development
APP_NAME=VERA
APP_VERSION=0.1.0
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://vera_user:vera_password@postgres:5432/vera_db
# For standalone local run without Docker:
# DATABASE_URL=postgresql+psycopg://vera_user:vera_password@localhost:5432/vera_db
# Fallback SQLite for unit test environments:
# DATABASE_URL=sqlite+aiosqlite:///./vera_dev.db

# Cache / Queue (Redis)
REDIS_URL=redis://redis:6379/0

# Object Storage (MinIO / S3)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=vera_minio_admin
MINIO_SECRET_KEY=vera_minio_secret
MINIO_BUCKET=vera-artifacts
MINIO_SECURE=false

# Provider Configurations (Phase 02: Ollama / Qwen3 and Mock support)
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
# For Docker running with host Ollama:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_TIMEOUT_SECONDS=60.0
LLM_TEMPERATURE=0.1

OCR_PROVIDER=unavailable
STT_PROVIDER=unavailable
DEEPFAKE_PROVIDER=unavailable
URL_CLASSIFIER_PROVIDER=unavailable
APK_CLASSIFIER_PROVIDER=unavailable
EMBEDDING_PROVIDER=unavailable

# Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:8000
